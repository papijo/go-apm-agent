# =============================================================================
# Distributed Observability Agent — Environment Variables
# Copy this file to .env and fill in any values marked as REQUIRED.
# Never commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=observability
POSTGRES_PASSWORD=observability_secret        # CHANGE in production
POSTGRES_DB=telemetry
DATABASE_URL=postgresql://observability:observability_secret@postgres:5432/telemetry
# Note: Docker maps container port 5432 to host port 5433 (avoids conflict with local PostgreSQL)
# Use port 5433 when connecting from host tools like pgAdmin

# -----------------------------------------------------------------------------
# Go Agent
# -----------------------------------------------------------------------------
OTLP_GRPC_PORT=4317                          # Port the agent listens on for OTLP/gRPC
FLUSH_INTERVAL_SECONDS=60                    # How often the buffer is flushed to PostgreSQL
SAMPLE_THRESHOLD_MS=5                        # B1: Spans shorter than this (ms) are dropped
PROMETHEUS_PORT=2112                         # B3: Port for Prometheus /metrics endpoint

# -----------------------------------------------------------------------------
# OpenTelemetry SDK — Node.js & Python services
# OTEL_SERVICE_NAME is set per-service inside docker-compose.yml, not here.
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://agent:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# -----------------------------------------------------------------------------
# FastAPI Query API
# -----------------------------------------------------------------------------
QUERY_API_PORT=8000

# -----------------------------------------------------------------------------
# Grafana  (B3: visualises Prometheus metrics + PostgreSQL data)
# -----------------------------------------------------------------------------
GRAFANA_PORT=3001
GRAFANA_PASSWORD=admin                       # CHANGE in production
